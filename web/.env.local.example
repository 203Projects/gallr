# gallr web — local environment variables
#
# Copy to .env.local and source before `npm run build` / `npm run dev`:
#
#   cp .env.local.example .env.local
#   set -a && source .env.local && set +a   # bash/zsh
#
# Without these, the build silently falls back to the SVG placeholder
# seed in scripts/showcase-seed.json. Local dev keeps that lenient
# behavior; production builds (VERCEL=1 or CI=true) error out instead.
#
# Get the values from the Supabase dashboard:
#   https://supabase.com/dashboard/project/<project-ref>/settings/api

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
