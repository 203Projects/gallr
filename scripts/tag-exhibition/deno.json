{
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "compilerOptions": { "strict": true },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check tag.ts tag_cli.ts tag_test.ts",
