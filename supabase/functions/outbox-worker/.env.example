# Invoke the function with: Authorization: Bearer <this value>
OUTBOX_WORKER_TOKEN=replace-with-at-least-32-random-bytes

# Supabase injects SUPABASE_URL and a legacy service-role key locally. Hosted
# projects should prefer a server-only secret key where available.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=replace-with-server-secret

OUTBOX_LEASE_SECONDS=300
OUTBOX_STALE_UPLOAD_HOURS=24
OUTBOX_SWEEP_BATCH_SIZE=50
OUTBOX_DELIVERY_TIMEOUT_MS=10000

# Required only when non-media events should be forwarded to another service.
OUTBOX_DELIVERY_URL=https://example.invalid/internal/outbox
OUTBOX_DELIVERY_TOKEN=replace-with-receiver-token
