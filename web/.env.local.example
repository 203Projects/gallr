# gallr web — local environment variables
#
# Variable-name reference only. Do not copy credentials into a persistent
# `.env.local` file. Inject the matching environment's values from 1Password
# into the `npm run build` / `npm run dev` process.
#
# Without these, the build silently falls back to the SVG placeholder
# seed in scripts/showcase-seed.json. Local dev keeps that lenient behavior;
# Vercel and explicitly verified builds error out instead.
#
# Use the environment-specific `gallr` or `gallr-staging` 1Password item as
# the source of truth. Only a publishable client key belongs here.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Closed reader contract: legacy (default/rollback) or canonical-v2.
# Do not switch this until the V2 database migration and reconciliation pass.
GALLR_EXHIBITION_SOURCE=legacy
# Set to 1 in staging/cutover evidence jobs so missing/unreachable live data
# fails the build instead of using bundled seeds.
GALLR_REQUIRE_LIVE_DATA=0
